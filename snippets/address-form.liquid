{%- comment -%} Params: address (customer.new_address or an address), form_id {%- endcomment -%}
{%- form 'customer_address', address, class: 'form-grid' -%}
  {%- if form.errors -%}
    <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
  {%- endif -%}
  <div class="form-grid form-grid--2">
    <label class="field"><span class="field__label">{{ 'customer.fields.first_name' | t }}</span>
      <input class="input" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
    <label class="field"><span class="field__label">{{ 'customer.fields.last_name' | t }}</span>
      <input class="input" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
  </div>
  <label class="field"><span class="field__label">{{ 'customer.fields.company' | t }}</span>
    <input class="input" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
  <label class="field"><span class="field__label">{{ 'customer.fields.address1' | t }}</span>
    <input class="input" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
  <label class="field"><span class="field__label">{{ 'customer.fields.address2' | t }}</span>
    <input class="input" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
  <div class="form-grid form-grid--2">
    <label class="field"><span class="field__label">{{ 'customer.fields.city' | t }}</span>
      <input class="input" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
    <label class="field"><span class="field__label">{{ 'customer.fields.zip' | t }}</span>
      <input class="input" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
  </div>
  <label class="field"><span class="field__label">{{ 'customer.fields.country' | t }}</span>
    <select class="select" id="AddressCountry_{{ form_id }}" name="address[country]" data-address-country="{{ form_id }}" data-default="{{ form.country }}" autocomplete="country">
      {{ all_country_option_tags }}
    </select></label>
  <label class="field" id="AddressProvinceWrap_{{ form_id }}"><span class="field__label">{{ 'customer.fields.province' | t }}</span>
    <select class="select" id="AddressProvince_{{ form_id }}" name="address[province]" data-default="{{ form.province }}" autocomplete="address-level1"></select></label>
  <label class="field"><span class="field__label">{{ 'customer.fields.phone' | t }}</span>
    <input class="input" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
  <label class="checkbox">
    {{ form.set_as_default_checkbox }}
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
  <div><button class="btn btn--sm" type="submit"><span>{{ 'customer.addresses.save' | t }}</span></button></div>
{%- endform -%}
