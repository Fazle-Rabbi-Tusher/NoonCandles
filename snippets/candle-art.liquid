{%- comment -%}
  Drawn Noon dessert candle: fluted coupe glass, piped whipped wax, strawberries, wick and live flame.
  Params:
    lit   (bool)   show the flame (default true)
    id    (string) unique suffix for gradient ids (default 'c')
    class (string) extra classes
  Parts for animation: .candle-art__flame (flame group), .candle-art__wax, .candle-art__glass
  Flame tip sits at (100, 14) and wick top at (100, 46) in the 200 × 300 viewBox.
{%- endcomment -%}
{%- liquid
  assign uid = id | default: 'c'
  assign show_flame = true
  if lit == false
    assign show_flame = false
  endif
-%}
<svg class="candle-art {{ class }}" viewBox="0 0 200 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="glass-{{ uid }}" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity=".32"/>
      <stop offset=".35" stop-color="#fff" stop-opacity=".08"/>
      <stop offset=".7" stop-color="#fff" stop-opacity=".16"/>
      <stop offset="1" stop-color="#fff" stop-opacity=".34"/>
    </linearGradient>
    <radialGradient id="cream-{{ uid }}" cx=".38" cy=".3" r=".8">
      <stop offset="0" stop-color="#FFFDF7"/>
      <stop offset=".6" stop-color="#F8EED5"/>
      <stop offset="1" stop-color="#E6D3AE"/>
    </radialGradient>
    <radialGradient id="berry-{{ uid }}" cx=".35" cy=".3" r=".9">
      <stop offset="0" stop-color="#E0384F"/>
      <stop offset=".55" stop-color="#B0122E"/>
      <stop offset="1" stop-color="#6E0A1D"/>
    </radialGradient>
    <radialGradient id="flame-{{ uid }}" cx=".5" cy=".78" r=".75">
      <stop offset="0" stop-color="#FFFFF4"/>
      <stop offset=".28" stop-color="#FFF1B8"/>
      <stop offset=".55" stop-color="#FFC25A"/>
      <stop offset=".82" stop-color="#FF8A2B" stop-opacity=".85"/>
      <stop offset="1" stop-color="#FF6A1A" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="halo-{{ uid }}" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#FFD98A" stop-opacity=".75"/>
      <stop offset=".45" stop-color="#FFB45A" stop-opacity=".25"/>
      <stop offset="1" stop-color="#FF9A3C" stop-opacity="0"/>
    </radialGradient>
  </defs>

  {%- comment -%} glass foot and stem {%- endcomment -%}
  <g class="candle-art__glass">
    <ellipse cx="100" cy="286" rx="50" ry="9" fill="url(#glass-{{ uid }})" stroke="#fff" stroke-opacity=".5"/>
    <ellipse cx="100" cy="283" rx="30" ry="4" fill="none" stroke="#fff" stroke-opacity=".25"/>
    <path d="M95 210 C96 240 95 262 92 280 H108 C105 262 104 240 105 210 Z" fill="url(#glass-{{ uid }})" stroke="#fff" stroke-opacity=".45"/>
  </g>

  {%- comment -%} fluted bowl with wax inside {%- endcomment -%}
  <g class="candle-art__bowl">
    <path d="M34 150 H166 L152 196 Q147 211 131 211 H69 Q53 211 48 196 Z" fill="#F6E7C6" fill-opacity=".85"/>
    <path d="M34 150 H166 L152 196 Q147 211 131 211 H69 Q53 211 48 196 Z" fill="url(#glass-{{ uid }})" stroke="#fff" stroke-opacity=".6" stroke-width="1.4"/>
    <g stroke="#fff" stroke-opacity=".22" stroke-width="1.2">
      <path d="M46 154 L57 205"/><path d="M58 154 L66 207"/><path d="M70 154 L76 209"/><path d="M82 154 L86 210"/>
      <path d="M94 154 L96 210"/><path d="M106 154 L104 210"/><path d="M118 154 L114 210"/><path d="M130 154 L124 209"/>
      <path d="M142 154 L134 207"/><path d="M154 154 L143 205"/>
    </g>
    <path d="M36 150 H164" stroke="#fff" stroke-opacity=".7" stroke-width="2" stroke-linecap="round"/>
  </g>

  {%- comment -%} piped whipped wax {%- endcomment -%}
  <g class="candle-art__wax" fill="url(#cream-{{ uid }})">
    <circle cx="44" cy="142" r="15"/><circle cx="64" cy="138" r="18"/><circle cx="86" cy="140" r="18"/>
    <circle cx="108" cy="139" r="18"/><circle cx="130" cy="140" r="18"/><circle cx="152" cy="142" r="15"/>
    <circle cx="62" cy="120" r="15"/><circle cx="82" cy="114" r="17"/><circle cx="104" cy="113" r="17"/><circle cx="126" cy="117" r="16"/><circle cx="142" cy="124" r="12"/>
    <circle cx="80" cy="94" r="13"/><circle cx="100" cy="88" r="15"/><circle cx="120" cy="95" r="12"/>
    <circle cx="98" cy="70" r="11"/><circle cx="104" cy="58" r="7"/>
  </g>
  <g class="candle-art__ridges" fill="none" stroke="#D9C49B" stroke-opacity=".7" stroke-width="1.3" stroke-linecap="round">
    <path d="M38 146 Q52 130 66 146"/><path d="M70 146 Q86 126 100 146"/><path d="M104 146 Q120 126 136 146"/><path d="M140 146 Q152 134 160 146"/>
    <path d="M56 124 Q70 106 86 124"/><path d="M90 122 Q106 102 120 122"/><path d="M122 126 Q134 112 146 128"/>
    <path d="M74 98 Q88 80 104 96"/><path d="M106 98 Q116 86 126 100"/>
    <path d="M92 74 Q100 62 108 72"/>
  </g>

  {%- comment -%} strawberries {%- endcomment -%}
  <g class="candle-art__berries">
    <g transform="translate(142 104) rotate(22)">
      <path d="M0 -18 C13 -18 20 -7 17 6 C13 17 5 24 0 27 C-5 24 -13 17 -17 6 C-20 -7 -13 -18 0 -18Z" fill="url(#berry-{{ uid }})"/>
      <g fill="#F6D38A"><ellipse cx="-7" cy="-4" rx="1" ry="1.6"/><ellipse cx="2" cy="-7" rx="1" ry="1.6"/><ellipse cx="9" cy="-1" rx="1" ry="1.6"/><ellipse cx="-3" cy="5" rx="1" ry="1.6"/><ellipse cx="6" cy="9" rx="1" ry="1.6"/><ellipse cx="-9" cy="8" rx="1" ry="1.6"/><ellipse cx="1" cy="16" rx="1" ry="1.6"/></g>
      <path d="M-12 -17 Q-4 -22 0 -16 Q4 -22 12 -17 Q6 -13 0 -14 Q-6 -13 -12 -17Z" fill="#5E8C3A"/>
    </g>
    <g transform="translate(58 106) rotate(-28) scale(.9)">
      <path d="M0 -18 C13 -18 20 -7 17 6 C13 17 5 24 0 27 C-5 24 -13 17 -17 6 C-20 -7 -13 -18 0 -18Z" fill="url(#berry-{{ uid }})"/>
      <g fill="#F6D38A"><ellipse cx="-6" cy="-5" rx="1" ry="1.6"/><ellipse cx="4" cy="-6" rx="1" ry="1.6"/><ellipse cx="8" cy="3" rx="1" ry="1.6"/><ellipse cx="-4" cy="6" rx="1" ry="1.6"/><ellipse cx="3" cy="13" rx="1" ry="1.6"/></g>
      <path d="M-12 -17 Q-4 -22 0 -16 Q4 -22 12 -17 Q6 -13 0 -14 Q-6 -13 -12 -17Z" fill="#5E8C3A"/>
    </g>
  </g>

  {%- comment -%} wick {%- endcomment -%}
  <path class="candle-art__wick" d="M100 60 C100 54 101 50 100 46" stroke="#2B1A14" stroke-width="2.6" stroke-linecap="round" fill="none"/>

  {%- comment -%} flame + halo {%- endcomment -%}
  {%- if show_flame -%}
    <g class="candle-art__flame">
      <circle class="candle-art__halo" cx="100" cy="30" r="34" fill="url(#halo-{{ uid }})"/>
      <path class="candle-art__fire" d="M100 48 C90 44 88 34 92 24 C95 17 99 12 100 4 C103 12 109 18 110 28 C111 38 108 45 100 48Z" fill="url(#flame-{{ uid }})"/>
      <ellipse cx="100" cy="45" rx="2.6" ry="3.6" fill="#6FA0FF" fill-opacity=".35"/>
    </g>
  {%- endif -%}
</svg>
