{%- comment -%}
  Large outline icons for the features band. Usage: {% render 'line-icon', name: 'pour' %}
{%- endcomment -%}
{%- capture a -%}class="line-icon line-icon--{{ name }}" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"{%- endcapture -%}
{%- case name -%}
