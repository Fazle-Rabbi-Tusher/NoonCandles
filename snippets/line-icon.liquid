    <svg {{ a }}><path d="M18 30v26c0 18 12 30 30 30 8 0 15-3 20-9l14-16c3-3 3-8 0-11-3-3-7-3-10 0l-6 6V20c0-4-3-7-7-7s-7 3-7 7v18 M52 38V14c0-4-3-7-7-7s-7 3-7 7v24 M38 38V20c0-4-3-7-7-7s-7 3-7 7v24 M24 44V30c0-4-3-6-6-6"/><path class="line-icon__drop" d="M84 70c0 4-3 7-6 7s-6-3-6-7c0-5 6-11 6-11s6 6 6 11z"/></svg>
  {%- when 'star' -%}
    <svg {{ a }}><path d="M50 10l11 26 28 2-21 18 7 28-25-15-25 15 7-28-21-18 28-2z"/></svg>
  {%- when 'drop' -%}
    <svg {{ a }}><path d="M50 8c0 18-30 30-30 52a30 30 0 0 0 60 0C80 38 50 26 50 8z"/><path d="M36 62a14 14 0 0 0 10 14"/></svg>
  {%- when 'no' -%}
