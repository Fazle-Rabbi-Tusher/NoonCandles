{%- comment -%} Usage: {% render 'pagination', paginate: paginate %} {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__step" aria-label="{{ 'general.pagination.previous' | t }}">{{ 'general.prev_short' | t }}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__step" aria-label="{{ 'general.pagination.next' | t }}">{{ 'general.next_short' | t }}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
