{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300..700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&display=swap" rel="stylesheet">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="password">
      <div class="password__inner account-card" style="max-width: 520px">
        {% render 'logo', variant: 'stacked' %}
        <h1 class="h2">{{ 'gift_card.heading' | t }}</h1>
        {%- assign initial_value = gift_card.initial_value | money -%}
        <p class="price price--lg">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="muted">{{ 'gift_card.initial' | t: value: initial_value }}</p>
        {%- endif -%}
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="form-message form-message--error">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="muted">{{ 'gift_card.expires' | t: date: expires }}</p>
        {%- endif -%}
        <div class="field w-full">
          <span class="field__label">{{ 'gift_card.code' | t }}</span>
          <input class="input text-center" type="text" value="{{ gift_card.code | format_code }}" readonly onclick="this.select()" aria-label="{{ 'gift_card.code' | t }}">
        </div>
        <div id="QrCode" data-code="{{ gift_card.qr_identifier }}" style="background: #fff; padding: 12px; border-radius: 16px"></div>
        <a class="btn" href="{{ shop.url }}" target="_blank" rel="noopener"><span>{{ 'gift_card.shop' | t }}</span></a>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_card.apple_wallet' | t }}" loading="lazy"></a>
        {%- endif -%}
        <button class="btn btn--outline btn--sm" type="button" onclick="window.print()"><span>{{ 'gift_card.print' | t }}</span></button>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.code, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
