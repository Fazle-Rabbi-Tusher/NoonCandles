<section class="collection-hero">
  <div class="page-width collection-hero__inner">
    <span class="eyebrow">{{ 'blogs.eyebrow' | t }}</span>
    <h1 data-split>{{ blog.title | escape }}</h1>
    {%- if blog.all_tags.size > 0 -%}
      <div class="tabs">
        <a class="pill{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">{{ 'blogs.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a class="pill{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="page-width">
    {%- paginate blog.articles by 9 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <a class="article-card" href="{{ article.url }}" data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 3 | times: 90 }}">
            <div class="article-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</span>
            <span class="h3">{{ article.title | escape }}</span>
            <span class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
          </a>
        {%- else -%}
          <p class="muted">{{ 'blogs.empty' | t }}</p>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": []
}
{% endschema %}
