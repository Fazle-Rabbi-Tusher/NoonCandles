{%- if section.blocks.size > 0 -%}
  <div class="announcement" data-announcement data-speed="{{ section.settings.speed }}" {{ section.shopify_attributes }}>
    <div class="announcement__inner">
      <div class="announcement__slides">
        {%- for block in section.blocks -%}
          <p class="announcement__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {%- if block.settings.highlight != blank -%}<strong>{{ block.settings.highlight | escape }}</strong> · {% endif -%}
            {{ block.settings.text | escape }}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Change message every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "highlight", "label": "Highlight", "default": "NEW" },
        { "type": "text", "id": "text", "label": "Text", "default": "The Whipped Cream collection is here" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
