<section class="collection-hero">
  <div class="page-width collection-hero__inner">
    <span class="eyebrow">{{ 'collections.eyebrow' | t }}</span>
    <h1 data-split>{{ section.settings.heading | default: 'Collections' }}</h1>
  </div>
</section>
<section class="section" style="padding-top: 0">
  <div class="page-width">
    <div class="collection-list">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
        <a class="collection-tile" href="{{ c.url }}" data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 4 | times: 80 }}">
          {%- if c.featured_image -%}
            {{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: c.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="collection-tile__label">{{ c.title | escape }} {% render 'icon', name: 'spark' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" }
  ]
}
{% endschema %}
