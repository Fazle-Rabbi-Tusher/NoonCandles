<section class="section">
  <div class="page-width">
    <div class="account-card">
      {% render 'logo', variant: 'mark' %}
      <h1 class="h2 text-center">{{ 'customer.activate.title' | t }}</h1>
      <p class="muted text-center">{{ 'customer.activate.text' | t }}</p>
      {%- form 'activate_customer_password', class: 'form-grid' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="field"><span class="field__label">{{ 'customer.fields.password' | t }}</span>
          <input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
        <label class="field"><span class="field__label">{{ 'customer.fields.password_confirm' | t }}</span>
          <input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
        <button class="btn btn--block" type="submit"><span>{{ 'customer.activate.submit' | t }}</span></button>
        <button class="btn btn--outline btn--block" type="submit" name="decline"><span>{{ 'customer.activate.decline' | t }}</span></button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
