<section class="section" style="padding-top: clamp(28px, 4vw, 56px)">
  <div class="page-width page-width--narrow stack" style="--stack: 1.6rem">
    <h1 data-split>{{ page.title | escape }}</h1>
    <div class="rte" data-reveal>{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
