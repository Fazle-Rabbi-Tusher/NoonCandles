{%- assign s = section.settings -%}
<section class="section carousel" data-carousel>
  <div class="page-width section-header" data-reveal>
    <div class="stack" style="--stack: .5rem">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ s.heading }}</h2>
    </div>
    <div class="carousel__nav">
      <button class="carousel__btn" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
      <button class="carousel__btn" type="button" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
  </div>

  <div class="carousel__track" data-carousel-track style="--slide-w: {{ s.slide_width }}px" data-reveal="fade">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <a class="reel" {% if b.link != blank %}href="{{ b.link }}" target="_blank" rel="noopener"{% else %}role="group"{% endif %} {{ block.shopify_attributes }}>
        {%- if b.video != blank -%}
          {{ b.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '500x' }}
        {%- elsif b.image != blank -%}
          {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '260px', alt: b.caption }}
        {%- else -%}
          {%- assign ph = forloop.index | modulo: 2 | plus: 1 -%}
          {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if b.caption != blank -%}<span class="reel__caption">{{ b.caption | escape }}</span>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>

  {%- if s.handle != blank -%}
    <p class="text-center" style="margin-top: 28px">
      <a class="btn btn--outline btn--sm" href="{{ settings.social_instagram | default: '#' }}" target="_blank" rel="noopener">
        {% render 'icon', name: 'instagram' %}<span>{{ s.handle | escape }}</span>
      </a>
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Reels / workshop",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the studio" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A peek at the pour" },
    { "type": "text", "id": "handle", "label": "Instagram button text", "default": "@nooncandles" },
    { "type": "range", "id": "slide_width", "label": "Card width", "min": 200, "max": 360, "step": 10, "unit": "px", "default": 260 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Image (if no video)" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Pouring a new batch" },
        { "type": "url", "id": "link", "label": "Link (e.g. Instagram post)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reels / workshop",
      "blocks": [
        { "type": "reel", "settings": { "caption": "Pouring a new batch" } },
        { "type": "reel", "settings": { "caption": "Whipping the wax" } },
        { "type": "reel", "settings": { "caption": "Matcha latte in the making" } },
        { "type": "reel", "settings": { "caption": "Cherry on top" } },
        { "type": "reel", "settings": { "caption": "Wrapped and ready" } }
      ]
    }
  ]
}
{% endschema %}
