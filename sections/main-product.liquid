{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media_id = current_variant.featured_media.id | default: product.featured_media.id
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section
  class="product"
  data-product
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  data-update-url="{{ section.settings.update_url }}"
>
  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/ld+json">{{ product | structured_data }}</script>

  <div class="page-width product__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="product__gallery" data-reveal="fade">
      <div class="product__main-media">
        {%- for media in product.media -%}
          <div class="media-slide{% if media.id == featured_media_id %} is-active{% endif %}" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign media_alt = media.alt | default: product.title | escape -%}
                {%- if media.id == featured_media_id -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 850px) 55vw, 100vw', widths: '600, 900, 1200, 1600', alt: media_alt }}
                {%- else -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 850px) 55vw, 100vw', widths: '600, 900, 1200, 1600', alt: media_alt }}
                {%- endif -%}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, playsinline: true, image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="media-slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button
              class="product__thumb"
              type="button"
              data-thumb="{{ media.id }}"
              aria-current="{% if media.id == featured_media_id %}true{% else %}false{% endif %}"
              aria-label="{{ 'products.product.view_media' | t: index: forloop.index }}"
            >
              {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Info {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'title' -%}
            <div class="stack" style="--stack: .6rem" {{ block.shopify_attributes }}>
              {%- if block.settings.show_collection and collection -%}
                <a class="eyebrow" href="{{ collection.url }}" style="text-decoration: none">{{ collection.title | escape }}</a>
              {%- elsif block.settings.show_vendor -%}
                <span class="eyebrow">{{ product.vendor | escape }}</span>
              {%- endif -%}
              <h1 class="product__title" data-split>{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div data-dynamic="price-{{ section.id }}" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, size: 'lg' %}
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="muted" style="font-size: .82rem; margin-top: 4px">
                  {%- if cart.taxes_included -%}{{ 'products.product.tax_included' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
                </p>
              {%- endif -%}
            </div>

          {%- when 'notes' -%}
            {%- liquid
              assign prefix = block.settings.tag_prefix | downcase
              assign prefix_size = prefix | size
              assign has_notes = false
            -%}
            {%- capture notes_html -%}
              {%- for tag in product.tags -%}
                {%- assign t = tag | downcase -%}
                {%- if t contains prefix and prefix_size > 0 -%}
                  {%- assign tag_start = tag | slice: 0, prefix_size | downcase -%}
                  {%- if tag_start == prefix -%}
                    {%- assign has_notes = true -%}
                    <span>{{ tag | slice: prefix_size, 60 | strip }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if has_notes -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}<p class="field__label" style="margin-bottom: 8px">{{ block.settings.heading | escape }}</p>{%- endif -%}
                <div class="product__notes">{{ notes_html }}</div>
              </div>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="stack" style="--stack: 1rem" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variant-picker">
                    <legend>{{ option.name | escape }}: <span class="muted">{{ option.selected_value | escape }}</span></legend>
                    <div class="variant-picker__options">
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                        <input
                          type="radio"
                          id="{{ input_id }}"
                          name="{{ section.id }}-option-{{ option.position }}"
                          value="{{ value | escape }}"
                          form="{{ form_id }}-picker"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label class="pill" for="{{ input_id }}">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="stack" style="--stack: 12px" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="product__buy" data-dynamic="buy-{{ section.id }}">
                  {%- if block.settings.show_quantity -%}
                    <div class="quantity">
                      <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t: product: product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
                      <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase' | t: product: product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                  {%- endif -%}
                  <button
                    class="btn"
                    type="submit"
                    name="add"
                    data-add-button
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }} · {{ current_variant.price | money }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="spinner" aria-hidden="true"></span>
                  </button>
                </div>
                <p class="form-message form-message--error" data-form-error hidden></p>
                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="product__dynamic-checkout">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'inventory' -%}
            <div data-dynamic="inventory-{{ section.id }}" {{ block.shopify_attributes }}>
              {%- if current_variant.inventory_management == 'shopify' -%}
                {%- if current_variant.inventory_quantity > block.settings.threshold -%}
                  <span class="inventory-note"><span class="dot"></span>{{ 'products.product.in_stock' | t }}</span>
                {%- elsif current_variant.inventory_quantity > 0 -%}
                  <span class="inventory-note inventory-note--low"><span class="dot"></span>{{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}</span>
                {%- elsif current_variant.available -%}
                  <span class="inventory-note"><span class="dot"></span>{{ 'products.product.made_to_order' | t }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>

          {%- when 'stats' -%}
            <div class="product__meta-list" {{ block.shopify_attributes }}>
              {%- if block.settings.stat_1_value != blank -%}<div class="product__meta-item"><strong>{{ block.settings.stat_1_value }}</strong>{{ block.settings.stat_1_label | escape }}</div>{%- endif -%}
              {%- if block.settings.stat_2_value != blank -%}<div class="product__meta-item"><strong>{{ block.settings.stat_2_value }}</strong>{{ block.settings.stat_2_label | escape }}</div>{%- endif -%}
              {%- if block.settings.stat_3_value != blank -%}<div class="product__meta-item"><strong>{{ block.settings.stat_3_value }}</strong>{{ block.settings.stat_3_label | escape }}</div>{%- endif -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <details{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {%- comment -%} Off-DOM form that groups the option radios so they don't submit with the cart form {%- endcomment -%}
  <form id="{{ form_id }}-picker" hidden></form>
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "update_url", "label": "Update URL when a variant is selected", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_collection", "label": "Show collection above title", "default": true },
        { "type": "checkbox", "id": "show_vendor", "label": "Otherwise show vendor", "default": false }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    {
      "type": "notes",
      "name": "Scent notes",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Scent notes" },
        {
          "type": "text",
          "id": "tag_prefix",
          "label": "Product tag prefix",
          "default": "note:",
          "info": "Tag products like “note:Vanilla”, “note:Cherry” to show them as chips."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hand-poured in small batches.</p>" }]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }
      ]
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "threshold", "label": "Low stock threshold", "min": 1, "max": 20, "step": 1, "default": 5 }
      ]
    },
    {
      "type": "stats",
      "name": "Candle facts",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Connect these to product metafields to change them per product." },
        { "type": "text", "id": "stat_1_value", "label": "Fact 1", "default": "60 h" },
        { "type": "text", "id": "stat_1_label", "label": "Fact 1 label", "default": "burn time" },
        { "type": "text", "id": "stat_2_value", "label": "Fact 2", "default": "Soy" },
        { "type": "text", "id": "stat_2_label", "label": "Fact 2 label", "default": "natural wax" },
        { "type": "text", "id": "stat_3_value", "label": "Fact 3", "default": "250 g" },
        { "type": "text", "id": "stat_3_label", "label": "Fact 3 label", "default": "net weight" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Candle care" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Burn for 2–3 hours the first time so the wax melts to the edge. Trim the wick to 5 mm before each light. Never leave a burning candle unattended.</p>"
        },
        { "type": "page", "id": "page", "label": "Content from page" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ]
}
{% endschema %}
