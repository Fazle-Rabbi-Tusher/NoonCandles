<section class="section cart-page" style="padding-top: clamp(28px, 4vw, 56px)">
  <div class="page-width" data-cart-section="{{ section.id }}">
    <span hidden data-cart-count-source="{{ cart.item_count }}"></span>
    <h1 style="margin-bottom: 32px">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page__grid" novalidate>
        <div>
          {% render 'shipping-bar' %}
          {% render 'cart-items' %}
          <noscript><button class="btn btn--outline btn--sm" type="submit" name="update" style="margin-top: 16px">{{ 'cart.update' | t }}</button></noscript>
        </div>

        <aside class="cart-page__summary">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-totals" style="font-size: .95rem; font-weight: 500">
              <span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-totals">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="cart-taxes">{{ 'cart.taxes_note' | t }}</p>
          {%- if settings.cart_show_note -%}
            <label class="field">
              <span class="field__label">{{ 'cart.note' | t }}</span>
              <textarea class="textarea" name="note" data-cart-note>{{ cart.note }}</textarea>
            </label>
          {%- endif -%}
          <button class="btn btn--block" type="submit" name="checkout"><span>{{ 'cart.checkout' | t }}</span></button>
          {%- if additional_checkout_buttons -%}
            <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </aside>
      </form>
    {%- else -%}
      <div class="cart-empty">
        {% render 'logo', variant: 'mark' %}
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <p class="muted">{{ 'cart.empty_text' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}"><span>{{ 'cart.continue' | t }}</span></a>
        {%- if shop.customer_accounts_enabled and customer == nil -%}
          <p class="muted">{{ 'cart.login_html' | t: link: routes.account_login_url }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
