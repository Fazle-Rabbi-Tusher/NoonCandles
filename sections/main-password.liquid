<section class="password">
  <div class="password__inner">
    {% render 'logo', variant: 'stacked' %}
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lead">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'stack w-full' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="search-form">
          <input class="input" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
          <button class="btn" type="submit"><span>{{ 'password.notify' | t }}</span></button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="w-full">
      <summary class="muted" style="cursor: pointer">{{ 'password.enter_store' | t }}</summary>
      {%- form 'storefront_password', class: 'search-form', style: 'margin-top: 14px' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'customer.fields.password' | t }}" aria-label="{{ 'customer.fields.password' | t }}">
        <button class="btn btn--outline" type="submit"><span>{{ 'password.enter' | t }}</span></button>
      {%- endform -%}
    </details>
    <p class="muted" style="font-size: .8rem">{{ 'password.admin_html' | t: link: '/admin' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something warm is <em>coming soon</em>" }
  ]
}
{% endschema %}
