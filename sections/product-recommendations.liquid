{%- comment -%} Product recommendations: tiles or cards on a coloured band (defaults to the deep Noon green). {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section recs recs--{{ s.style }}" style="--recs-bg: {{ s.bg }}; --recs-ink: {{ s.ink }};">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header" data-reveal>
        <h2 class="recs__heading">{{ s.heading }}</h2>
      </div>
    {%- endif -%}
    <div
      class="{% if s.style == 'tiles' %}tile-grid{% else %}product-grid{% endif %}"
      style="--cols: {{ s.columns }}"
      data-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related"
    >
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products -%}
          <div data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}">
            {%- if s.style == 'tiles' -%}
              {% render 'product-card', product: rec, index: forloop.index0, style: 'tile', sizes: '(min-width: 990px) 30vw, 80vw' %}
            {%- else -%}
              {% render 'product-card', product: rec, index: forloop.index0 %}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "You might also <em>love</em>" },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "options": [
        { "value": "tiles", "label": "Gradient tiles with Quick add" },
        { "value": "grid", "label": "Classic cards" }
      ],
      "default": "tiles"
    },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#4C563C" },
    { "type": "color", "id": "ink", "label": "Text", "default": "#F8EED5" }
  ],
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
