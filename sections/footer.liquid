<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {% render 'logo', variant: 'stacked' %}
        {%- if section.settings.about != blank -%}
          <p>{{ section.settings.about | escape }}</p>
        {%- endif -%}
        <div class="social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>{%- endif -%}
          {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <h2 class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title | escape }}</h2>
              <ul class="footer__links list-unstyled" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              <div class="footer__links rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- form 'customer', id: 'FooterNewsletter', class: 'stack' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-message form-message--success" style="color: var(--c-cherry)">{{ 'newsletter.success' | t }}</p>
                {%- else -%}
                  {%- if form.errors -%}<p class="form-message form-message--error" style="background: var(--c-cream)">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
                  <div class="newsletter__form">
                    <input class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}">
                    <button class="btn btn--matcha btn--sm" type="submit"><span>{{ 'newsletter.button' | t }}</span></button>
                  </div>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }} · {{ powered_by_link }}</span>

      {%- if section.settings.show_localization and localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'localization-form' -%}
          <select class="select" name="country_code" data-localization-select aria-label="{{ 'footer.country' | t }}">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.show_payment -%}
        <ul class="payment-icons list-unstyled" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_giant_logo -%}
    <div class="footer__giant" aria-hidden="true">{% render 'logo', variant: 'wordmark' %}</div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "textarea",
      "id": "about",
      "label": "Short brand text",
      "default": "Hand-poured candles, made in small batches. The flame is the dot of the ن — our little light for your home."
    },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show country / currency selector", "default": true },
    { "type": "checkbox", "id": "show_giant_logo", "label": "Show large wordmark at bottom", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers where you make your candles, or how to reach you.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the glow list" },
        { "type": "paragraph", "content": "Sign-ups are saved as customers in Shopify with email marketing consent." }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
