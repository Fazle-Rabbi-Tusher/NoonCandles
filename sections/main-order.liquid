<section class="section" style="padding-top: clamp(28px, 4vw, 56px)">
  <div class="page-width">
    <a class="link-arrow" href="{{ routes.account_url }}" style="margin-bottom: 16px">{% render 'icon', name: 'arrow-left' %} {{ 'customer.account.title' | t }}</a>
    <h1 style="margin: 12px 0 6px">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="muted">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}
      <p class="form-message form-message--error" style="margin-top: 14px">{{ 'customer.order.cancelled' | t: date: order.cancelled_at }} — {{ order.cancel_reason_label }}</p>
    {%- endif -%}

    <div class="account-grid" style="margin-top: 32px">
      <table class="order-table">
        <thead>
          <tr>
            <th scope="col">{{ 'customer.order.product' | t }}</th>
            <th scope="col">{{ 'customer.order.price' | t }}</th>
            <th scope="col">{{ 'customer.order.quantity' | t }}</th>
            <th scope="col">{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td data-label="{{ 'customer.order.product' | t }}">
                {{ line_item.title | link_to: line_item.product.url }}
                {%- if line_item.fulfillment -%}
                  <div class="muted" style="font-size: .85rem">
                    {{ 'customer.order.fulfilled' | t: date: line_item.fulfillment.created_at }}
                    {%- if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track' | t }}</a>{% endif -%}
                  </div>
                {%- endif -%}
              </td>
              <td data-label="{{ 'customer.order.price' | t }}">{{ line_item.final_price | money }}</td>
              <td data-label="{{ 'customer.order.quantity' | t }}">{{ line_item.quantity }}</td>
              <td data-label="{{ 'customer.orders.total' | t }}">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">{{ 'cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for discount in order.cart_level_discount_applications -%}
            <tr><td colspan="3">{{ discount.title }}</td><td>−{{ discount.total_allocated_amount | money }}</td></tr>
          {%- endfor -%}
          {%- for shipping_method in order.shipping_methods -%}
            <tr><td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr><td colspan="3">{{ tax_line.title }} ({{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>
          {%- endfor -%}
          <tr><td colspan="3"><strong>{{ 'customer.orders.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table>

      <aside class="stack" style="--stack: 1rem">
        <div class="address-card stack" style="--stack: .5rem">
          <h2 class="h4">{{ 'customer.order.billing' | t }}</h2>
          <p class="muted">{{ 'customer.orders.payment' | t }}: {{ order.financial_status_label }}</p>
          <div class="muted">{{ order.billing_address | format_address }}</div>
        </div>
        <div class="address-card stack" style="--stack: .5rem">
          <h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2>
          <p class="muted">{{ 'customer.orders.fulfillment' | t }}: {{ order.fulfillment_status_label }}</p>
          <div class="muted">{{ order.shipping_address | format_address }}</div>
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Customer order", "settings": [] }
{% endschema %}
