<section class="collection-hero">
  <div class="page-width collection-hero__inner">
    <span class="eyebrow">{{ 'search.title' | t }}</span>
    <h1>
      {%- if search.performed -%}
        {{ 'search.results_for' | t: terms: search.terms }}
      {%- else -%}
        {{ 'search.title' | t }}
      {%- endif -%}
    </h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
      <button class="btn" type="submit"><span>{{ 'header.search' | t }}</span></button>
    </form>
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="page-width">
    {%- if search.performed -%}
      {%- paginate search.results by 16 -%}
        <p class="muted" style="margin-bottom: 24px">{{ 'search.count' | t: count: search.results_count }}</p>
        {%- if search.results_count > 0 -%}
          <div class="product-grid">
            {%- for item in search.results -%}
              <div data-reveal>
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {% render 'product-card', product: item, index: forloop.index0 %}
                  {%- when 'article' -%}
                    <a class="article-card" href="{{ item.url }}">
                      <div class="article-card__media">
                        {%- if item.image -%}{{ item.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: item.title }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                      </div>
                      <span class="h4">{{ item.title | escape }}</span>
                    </a>
                  {%- when 'page' -%}
                    <a class="article-card" href="{{ item.url }}">
                      <div class="article-card__media">{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                      <span class="h4">{{ item.title | escape }}</span>
                    </a>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state">
            <p class="h3">{{ 'search.no_results' | t }}</p>
            <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}"><span>{{ 'cart.continue' | t }}</span></a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
