<section class="section">
  <div class="page-width">
    <div class="account-card">
      {% render 'logo', variant: 'mark' %}
      <h1 class="h2 text-center">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate', class: 'form-grid' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form-grid form-grid--2">
          <label class="field">
            <span class="field__label">{{ 'customer.fields.first_name' | t }}</span>
            <input class="input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
          </label>
          <label class="field">
            <span class="field__label">{{ 'customer.fields.last_name' | t }}</span>
            <input class="input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
          </label>
        </div>
        <label class="field">
          <span class="field__label">{{ 'customer.fields.email' | t }}</span>
          <input class="input" type="email" name="customer[email]" autocomplete="email" required value="{{ form.email }}">
        </label>
        <label class="field">
          <span class="field__label">{{ 'customer.fields.password' | t }}</span>
          <input class="input" type="password" name="customer[password]" autocomplete="new-password" required>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="customer[accepts_marketing]" value="true">
          <span>{{ 'customer.register.marketing' | t }}</span>
        </label>
        <button class="btn btn--block" type="submit"><span>{{ 'customer.register.submit' | t }}</span></button>
        <p class="text-center muted">{{ 'customer.register.login_html' | t: link: routes.account_login_url }}</p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
