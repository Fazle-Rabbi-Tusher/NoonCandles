{%- assign s = section.settings -%}
<section class="features" style="--features-bg: {{ s.bg }}; --features-ink: {{ s.ink }};">
  <div class="page-width features__inner">
    <div class="features__heads" data-reveal>
      <h2 class="features__h">{{ s.heading_1 | escape }}</h2>
      <span class="features__rule" aria-hidden="true"></span>
      <h2 class="features__h">{{ s.heading_2 | escape }}</h2>
    </div>
    <ul class="features__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="features__item" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 90 }}" {{ block.shopify_attributes }}>
          <span class="features__icon">
            {% render 'line-icon', name: block.settings.icon %}
            {%- if block.settings.icon == 'pour' -%}
              <span class="features__drips" aria-hidden="true"><i></i><i></i></span>
            {%- endif -%}
          </span>
          <span class="features__l1">{{ block.settings.line_1 | escape }}</span>
          <span class="features__l2">{{ block.settings.line_2 | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients band",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading_1", "label": "Heading 1", "default": "Playful Shapes" },
    { "type": "text", "id": "heading_2", "label": "Heading 2", "default": "Quality Ingredients" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#DDE9C6" },
    { "type": "color", "id": "ink", "label": "Text and icons", "default": "#2E3A22" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "pour", "label": "Hand pouring" },
            { "value": "star", "label": "Star" },
            { "value": "drop", "label": "Wax drop" },
            { "value": "no", "label": "Cross (free from)" },
            { "value": "cotton", "label": "Cotton" },
            { "value": "paw", "label": "Paw" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "flame", "label": "Flame" },
            { "value": "heart", "label": "Heart" },
            { "value": "strawberry", "label": "Strawberry" }
          ],
          "default": "pour"
        },
        { "type": "text", "id": "line_1", "label": "Line 1 (italic)", "default": "Hand Poured" },
        { "type": "text", "id": "line_2", "label": "Line 2 (caps)", "default": "In small batches" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients band",
      "blocks": [
        { "type": "feature", "settings": { "icon": "pour", "line_1": "Hand Poured", "line_2": "In small batches" } },
        { "type": "feature", "settings": { "icon": "star", "line_1": "Phthalate-Free", "line_2": "Fragrance" } },
        { "type": "feature", "settings": { "icon": "drop", "line_1": "Soy Blend", "line_2": "Wax" } },
        { "type": "feature", "settings": { "icon": "no", "line_1": "No Additives or", "line_2": "Preservatives" } },
        { "type": "feature", "settings": { "icon": "cotton", "line_1": "Cotton Core", "line_2": "Wicks" } },
        { "type": "feature", "settings": { "icon": "paw", "line_1": "Cruelty-Free", "line_2": "Always" } }
      ]
    }
  ]
}
{% endschema %}
