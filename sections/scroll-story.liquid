{%- comment -%}
  Scroll story: a scroll-scrubbed, frame-by-frame sequence.
  Hero orbs → statement panel → shape reveal → one orb → splits into two → many orbs + stats.
  Timeline lives in assets/scroll-story.js; visuals in assets/scroll-story.css.
{%- endcomment -%}
{{ 'scroll-story.css' | asset_url | stylesheet_tag }}
<script src="{{ 'scroll-story.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign shape = s.reveal_shape | default: 'arch'
-%}
<section
  class="story story--{{ shape }}"
  data-story
  style="--story-length: {{ s.length }}vh"
  aria-label="{{ s.hero_heading | strip_html | escape }}"
>
  <div class="story__stage" data-story-stage>
    {%- comment -%} Layer 1: gradient backdrop {%- endcomment -%}
    <div class="story__bg" aria-hidden="true"></div>

    {%- comment -%} Layer 2: hero orbs {%- endcomment -%}
    <div class="story__orb orb orb--dark" data-orb="h1" aria-hidden="true"></div>
    <div class="story__orb orb orb--light" data-orb="h2" aria-hidden="true"></div>

    {%- comment -%} Layer 3: hero copy {%- endcomment -%}
    <div class="story__hero" data-layer="hero">
      {%- if s.hero_eyebrow != blank -%}<span class="story__eyebrow">{{ s.hero_eyebrow | escape }}</span>{%- endif -%}
      <h2 class="story__title">{{ s.hero_heading }}</h2>
      {%- if s.hero_text != blank -%}<p class="story__sub">{{ s.hero_text | escape }}</p>{%- endif -%}
    </div>
    <button class="story__down" type="button" data-story-next data-layer="down" aria-label="{{ 'general.next' | t }}">
      {% render 'icon', name: 'arrow-right' %}
    </button>

    {%- comment -%} Layer 4: solid panel with statement {%- endcomment -%}
    <div class="story__panel" data-layer="panel">
      <div class="story__statement" data-layer="statement">
        <h2 class="story__title story__title--md">{{ s.statement_heading }}</h2>
        {%- if s.statement_text != blank -%}<p class="story__sub">{{ s.statement_text | escape }}</p>{%- endif -%}
      </div>
    </div>

    {%- comment -%} Layer 5: shape reveal with the main orbs inside {%- endcomment -%}
    <div class="story__reveal" data-layer="reveal" aria-hidden="true">
      <div class="story__bg story__bg--reveal"></div>
      <div class="story__dim" data-layer="dim"></div>
      <div class="story__orb orb orb--light" data-orb="b"></div>
      <div class="story__orb orb orb--dark" data-orb="a">
        <span class="story__mark" data-layer="mark">{% render 'logo', variant: 'mark' %}</span>
      </div>
      {%- for i in (1..10) -%}
        <div class="story__orb orb orb--{% cycle 'dark', 'light', 'dark', 'dark', 'light' %} orb--small" data-orb="s{{ i }}"></div>
      {%- endfor -%}
    </div>

    {%- comment -%} Layer 6: final copy + stats {%- endcomment -%}
    <div class="story__final" data-layer="final">
      <div class="story__final-copy">
        {%- if s.final_eyebrow != blank -%}<span class="story__eyebrow story__eyebrow--dot">{{ s.final_eyebrow | escape }}</span>{%- endif -%}
        <h2 class="story__title story__title--md">{{ s.final_heading }}</h2>
        {%- if s.final_button_label != blank -%}
          <a class="btn btn--light" href="{{ s.final_button_link | default: routes.all_products_collection_url }}">
            <span>{{ s.final_button_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="story__stats">
          {%- for block in section.blocks -%}
            <div class="story__stat" data-layer="stat-{{ forloop.index }}" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scroll story",
  "class": "story-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "A scroll-driven animation: scrolling plays it forward frame by frame. Works best as the first section on the home page."
    },
    {
      "type": "range",
      "id": "length",
      "label": "Scroll length",
      "info": "Longer = slower animation.",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "vh",
      "default": 750
    },
    {
      "type": "select",
      "id": "reveal_shape",
      "label": "Reveal shape",
      "options": [
        { "value": "arch", "label": "Arch (candle jar)" },
        { "value": "diamond", "label": "Rounded diamond" }
      ],
      "default": "arch"
    },
    { "type": "header", "content": "1 · Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Hand-poured candles" },
    { "type": "inline_richtext", "id": "hero_heading", "label": "Heading", "default": "A little light isn’t found. <em>It’s poured.</em>" },
    { "type": "text", "id": "hero_text", "label": "Text", "default": "Made by hand, one small batch at a time." },
    { "type": "header", "content": "2 · Statement" },
    {
      "type": "inline_richtext",
      "id": "statement_heading",
      "label": "Heading",
      "default": "Every candle is melted, scented, poured and finished by hand."
    },
    { "type": "text", "id": "statement_text", "label": "Text", "default": "No two are quite the same — that’s the point." },
    { "type": "header", "content": "3 · Finale" },
    { "type": "text", "id": "final_eyebrow", "label": "Eyebrow", "default": "What we make" },
    {
      "type": "inline_richtext",
      "id": "final_heading",
      "label": "Heading",
      "default": "Small-batch candles. From the first pour to your front door."
    },
    { "type": "text", "id": "final_button_label", "label": "Button label", "default": "Shop candles" },
    { "type": "url", "id": "final_button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Scents in rotation" },
        { "type": "text", "id": "value", "label": "Value", "default": "24" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scroll story",
      "blocks": [
        { "type": "stat", "settings": { "label": "Scents in rotation", "value": "24" } },
        { "type": "stat", "settings": { "label": "Slow, clean burn", "value": "Up to 60 h" } },
        { "type": "stat", "settings": { "label": "Wax", "value": "100% soy · hand-poured" } }
      ]
    }
  ]
}
{% endschema %}
