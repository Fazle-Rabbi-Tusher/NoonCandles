{%- comment -%}
  Scroll story — scrubbed frame by frame by scroll.
  1 bright hero: headline + product photo in an arch → 2 the room dims, the arch becomes a window
  onto a real candle photo → 3 the candle lights, the arch opens and we zoom into the flame
  → 4 its light floods the screen, the Noon ن appears (the flame is its dot)
  → 5 the light splits into two orbs (product photos) → 6 a cluster of photo orbs + stats.
  Timeline: assets/scroll-story.js · visuals: assets/scroll-story.css
{%- endcomment -%}
{{ 'scroll-story.css' | asset_url | stylesheet_tag }}
<script src="{{ 'scroll-story.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign zoom_img = s.hero_image | default: s.hero_photo
  assign chip = s.hero_product
-%}
<section
  class="story"
  data-story
  style="--story-length: {{ s.length }}vh"
  aria-label="{{ s.hero_heading | strip_html | escape }}"
>
  <div class="story__stage" data-story-stage>
    <div class="story__bg" aria-hidden="true"></div>
    <div class="story__night" data-layer="night" aria-hidden="true"></div>
    <div class="story__warm" data-layer="warm" aria-hidden="true"></div>

    {%- for i in (1..5) -%}
      <div class="story__orb orb orb--bokeh" data-orb="k{{ i }}" aria-hidden="true"></div>
    {%- endfor -%}

    {%- comment -%} The arch: hero photo first, then a window onto the lit candle {%- endcomment -%}
    <div class="story__frame" data-layer="frame" aria-hidden="true">
      {%- if s.hero_photo != blank -%}
        <div class="story__frame-hero" data-layer="heroimg">
          {{ s.hero_photo | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 36vw, 74vw', alt: '' }}
        </div>
      {%- endif -%}
      {%- if zoom_img != blank -%}
        <div
          class="story__photo"
          data-layer="photo"
          data-iw="{{ zoom_img.width }}"
          data-ih="{{ zoom_img.height }}"
          data-fx="{{ s.flame_x | divided_by: 100.0 }}"
          data-fy="{{ s.flame_y | divided_by: 100.0 }}"
        >
          {{ zoom_img | image_url: width: 2000 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2000', sizes: '200vw', alt: '' }}
        </div>
        <div class="story__shade" data-layer="shade"></div>
      {%- endif -%}
    </div>
    <div class="story__glow" data-layer="glow" aria-hidden="true"><span class="story__glow-core"></span></div>

    {%- comment -%} 1 · bright hero copy {%- endcomment -%}
    <div class="story__hero" data-layer="hero">
      <div class="story__hero-inner">
        {%- if s.hero_eyebrow != blank -%}<span class="story__eyebrow">{{ s.hero_eyebrow | escape }}</span>{%- endif -%}
        <h2 class="story__title">{{ s.hero_heading }}</h2>
        {%- if s.hero_text != blank -%}<p class="story__sub">{{ s.hero_text | escape }}</p>{%- endif -%}
        <div class="story__actions">
          {%- if s.hero_button_label != blank -%}
            <a class="btn" href="{{ s.hero_button_link | default: routes.all_products_collection_url }}">
              <span>{{ s.hero_button_label | escape }}</span>{% render 'icon', name: 'spark' %}
            </a>
          {%- endif -%}
          {%- if s.hero_link_label != blank -%}
            <a class="story__textlink" href="{{ s.hero_link_link | default: '#' }}">{{ s.hero_link_label | escape }}</a>
          {%- endif -%}
        </div>
        {%- if chip != blank -%}
          <a class="story__chip" href="{{ chip.url }}">
            {%- if chip.featured_media -%}
              {{ chip.featured_media | image_url: width: 160 | image_tag: loading: 'eager', alt: '', width: 48, height: 48 }}
            {%- endif -%}
            <span class="story__chip-text">
              <span class="story__chip-name">{{ chip.title | escape }}</span>
              <span class="story__chip-price">{{ chip.price | money }}</span>
            </span>
            {% render 'icon', name: 'spark' %}
          </a>
        {%- endif -%}
      </div>
    </div>
    <button class="story__down" type="button" data-story-next data-layer="down" aria-label="{{ 'general.scroll' | t }}">
      {% render 'icon', name: 'arrow-down' %}
    </button>

    {%- comment -%} 3 · statement over the flame {%- endcomment -%}
    <div class="story__statement" data-layer="statement">
      <h2 class="story__title story__title--md">{{ s.statement_heading }}</h2>
      {%- if s.statement_text != blank -%}<p class="story__sub">{{ s.statement_text | escape }}</p>{%- endif -%}
    </div>

    {%- comment -%} 4–6 · light floods the screen {%- endcomment -%}
    <div class="story__fill" data-layer="fill" aria-hidden="true">
      <div class="story__dusk" data-layer="dusk"></div>
      <div class="story__dim" data-layer="dim"></div>

      <div class="story__mark" data-layer="mark">
        {% render 'logo', variant: 'mark' %}
        {%- if s.mark_caption != blank -%}<p class="story__mark-caption">{{ s.mark_caption | escape }}</p>{%- endif -%}
      </div>

      {%- for pair in (1..2) -%}
        {%- if pair == 1 -%}{%- assign orb_img = s.orb_b_image -%}{%- assign orb_id = 'b' -%}{%- else -%}{%- assign orb_img = s.orb_a_image -%}{%- assign orb_id = 'a' -%}{%- endif -%}
        <div class="story__orb orb {% if orb_img %}orb--photo{% else %}orb--lit{% endif %}" data-orb="{{ orb_id }}">
          {%- if orb_img -%}
            {{ orb_img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '90vmin', alt: '' }}
          {%- else -%}
            <span class="orb__flame"></span>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- for i in (1..10) -%}
        {%- liquid
          assign photo = nil
          if i <= 6
            assign key = 'photo_' | append: i
            assign photo = s[key]
          endif
        -%}
        <div class="story__orb orb {% if photo %}orb--photo{% else %}orb--lit orb--small{% endif %}" data-orb="s{{ i }}">
          {%- if photo -%}
            {{ photo | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '40vw', alt: '' }}
          {%- else -%}
            <span class="orb__flame"></span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} 6 · finale {%- endcomment -%}
    <div class="story__final" data-layer="final">
      <div class="story__final-copy">
        {%- if s.final_eyebrow != blank -%}<span class="story__eyebrow story__eyebrow--dot">{{ s.final_eyebrow | escape }}</span>{%- endif -%}
        <h2 class="story__title story__title--md">{{ s.final_heading }}</h2>
        {%- if s.final_button_label != blank -%}
          <a class="btn btn--light" href="{{ s.final_button_link | default: routes.all_products_collection_url }}">
            <span>{{ s.final_button_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="story__stats">
          {%- for block in section.blocks -%}
            <div class="story__stat" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scroll story",
  "class": "story-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "paragraph",
      "content": "Bright hero that scrolls into a candle lighting up. Works best as the first section on the home page."
    },
    {
      "type": "range",
      "id": "length",
      "label": "Scroll length",
      "info": "Longer = slower animation.",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "vh",
      "default": 800
    },
    { "type": "header", "content": "1 · Hero" },
    { "type": "image_picker", "id": "hero_photo", "label": "Hero photo (in the arch)", "info": "A bright product photo. Portrait works best." },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Hand-poured dessert candles" },
    { "type": "inline_richtext", "id": "hero_heading", "label": "Heading", "default": "A little light isn’t found. <em>It’s poured.</em>" },
    { "type": "text", "id": "hero_text", "label": "Text", "default": "Whipped, piped and finished by hand — candles that look good enough to eat." },
    { "type": "text", "id": "hero_button_label", "label": "Button label", "default": "Shop candles" },
    { "type": "url", "id": "hero_button_link", "label": "Button link" },
    { "type": "text", "id": "hero_link_label", "label": "Text link label", "default": "Our story" },
    { "type": "url", "id": "hero_link_link", "label": "Text link" },
    { "type": "product", "id": "hero_product", "label": "Featured product chip", "info": "Shows the product photo, name and live price under the buttons." },
    { "type": "header", "content": "2 · The candle lights" },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Lit candle photo",
      "info": "Appears inside the arch as the room dims, then we zoom into its flame."
    },
    { "type": "range", "id": "flame_x", "label": "Flame position across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 51 },
    { "type": "range", "id": "flame_y", "label": "Flame position down", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 49 },
    { "type": "image_picker", "id": "orb_a_image", "label": "Split orb photo 1", "info": "The light splits into two orbs. Show a product in each." },
    { "type": "image_picker", "id": "orb_b_image", "label": "Split orb photo 2" },
    { "type": "header", "content": "3 · Into the flame" },
    {
      "type": "inline_richtext",
      "id": "statement_heading",
      "label": "Heading",
      "default": "Every candle is whipped, piped and finished by hand."
    },
    { "type": "text", "id": "statement_text", "label": "Text", "default": "Sweet enough to eat. Please don’t." },
    { "type": "text", "id": "mark_caption", "label": "Caption under the logo", "default": "Our flame is the dot of the ن." },
    { "type": "header", "content": "4 · Finale" },
    { "type": "text", "id": "final_eyebrow", "label": "Eyebrow", "default": "What we make" },
    {
      "type": "inline_richtext",
      "id": "final_heading",
      "label": "Heading",
      "default": "Dessert candles. From the first pour to your front door."
    },
    { "type": "text", "id": "final_button_label", "label": "Button label", "default": "Shop candles" },
    { "type": "url", "id": "final_button_link", "label": "Button link" },
    {
      "type": "header",
      "content": "Photos in the final orbs",
      "info": "Square-ish product photos work best. Empty slots show glowing flames."
    },
    { "type": "image_picker", "id": "photo_1", "label": "Photo 1 (large, left)" },
    { "type": "image_picker", "id": "photo_2", "label": "Photo 2" },
    { "type": "image_picker", "id": "photo_3", "label": "Photo 3" },
    { "type": "image_picker", "id": "photo_4", "label": "Photo 4" },
    { "type": "image_picker", "id": "photo_5", "label": "Photo 5" },
    { "type": "image_picker", "id": "photo_6", "label": "Photo 6" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Dessert designs" },
        { "type": "text", "id": "value", "label": "Value", "default": "20+" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scroll story",
      "blocks": [
        { "type": "stat", "settings": { "label": "Dessert designs", "value": "20+" } },
        { "type": "stat", "settings": { "label": "Made", "value": "By hand, in small batches" } },
        { "type": "stat", "settings": { "label": "Wax", "value": "Soy blend · cotton wicks" } }
      ]
    }
  ]
}
{% endschema %}
