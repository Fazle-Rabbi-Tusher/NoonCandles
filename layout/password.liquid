<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_cherry }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {% render 'meta-tags' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300..700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&display=swap"
      rel="stylesheet"
    >
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = 'js';</script>
    {{ content_for_header }}
  </head>
  <body class="has-glow">
    <div class="page-glow" aria-hidden="true">
      <span class="page-glow__blob page-glow__blob--cherry"></span>
      <span class="page-glow__blob page-glow__blob--matcha"></span>
      <span class="page-glow__blob page-glow__blob--cream"></span>
    </div>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
